# Copie para .env e preencha. Nunca commitar o .env preenchido.

# postgres://<user>:<password>@<host>:<port>/<database>?sslmode=disable
DATABASE_URL=

# openssl rand -base64 32
MASTER_ENCRYPTION_KEY=

# Só preencher durante rotação de chave mestra (ver docs/Infraestrutura.md)
MASTER_ENCRYPTION_KEY_PREVIOUS=

HTTP_ADDR=:8081
SESSION_COOKIE_NAME=backapeando_backup_session
SESSION_IDLE_TTL=43200
SESSION_ABSOLUTE_TTL=604800

# Obrigatória (o processo falha no boot se estiver ausente ou não for
# exatamente "true"/"false") — nunca há mais um default implícito.
# Deixar em "true" sempre que houver TLS na frente (produção/homolog).
# Só usar "false" em desenvolvimento local sem HTTPS.
SECURE_COOKIES=true

# Opcional. Deixar vazio quando frontend e backend são same-origin (padrão
# em todo docker-compose deste projeto, via proxy Nginx/Traefik). Só
# preencher para um deployment genuinamente cross-origin (ex.: `npm run
# dev` apontando para uma API remota) — aceita exatamente UMA origem, nunca
# "*" (incompatível com cookies/credentials).
CORS_ALLOWED_ORIGIN=
